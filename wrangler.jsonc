{
  "$schema": "./node_modules/wrangler/config-schema.json",

  "name": "my-first",
  "main": "worker.js",

  "compatibility_date": "2026-09-11",

  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  },

  "vars": {
    "GITHUB_OWNER": "zotakbook-cmd",
    "GITHUB_REPO": "Arsh",
    "GITHUB_BRANCH": "main"
  }
}
